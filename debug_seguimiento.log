2026-06-17 12:24:11 load_work_orders: executing SQL:
SELECT 
                                COALESCE(o.ESTADO, 'N') as estado,
                                o.ID_ORDEN as orden,
                                o.FECHA_SOLICITUD as solicitud,
                                COALESCE(u2.NOMBRE_USUARIO, '') as solicitante,
                                COALESCE(tuo.NOMBRE_TURNO, '') as turno,
                                COALESCE(CASE WHEN CHARINDEX(' - ', o.DESCRIPCION) > 0 THEN LEFT(o.DESCRIPCION, CHARINDEX(' - ', o.DESCRIPCION) - 1) ELSE LEFT(o.DESCRIPCION, 100) END, '') as titulo,
                                COALESCE(d.NOMBRE_ROL, '') as depto,
                            COALESCE(m.NOMBRE_MAQUINA, mf.NOMBRE_MAQUINA, '') as maquina,
                            COALESCE(u2.ID_DEPARTAMENTO, '') as dept_usuario
                            FROM ORDENES o
                            LEFT JOIN DEPARTAMENTOS d ON o.ID_DEPARTAMENTO = d.ID_DEPARTAMENTO
                            LEFT JOIN MAQUINAS m ON (o.ID_MAQUINA = m.ID_MAQUINA OR ('M' + RIGHT('000' + CAST(o.ID_MAQUINA AS VARCHAR(10)), 3)) = m.ID_MAQUINA)
                            LEFT JOIN (
                                SELECT ID_ORDEN, MIN(ID_MAQUINA) AS ID_MAQUINA
                                FROM ORDENES_FALLAS
                                WHERE ID_MAQUINA IS NOT NULL AND LTRIM(RTRIM(ID_MAQUINA)) <> ''
                                GROUP BY ID_ORDEN
                            ) AS ofm ON ofm.ID_ORDEN = o.ID_ORDEN
                            LEFT JOIN MAQUINAS mf ON (ofm.ID_MAQUINA = mf.ID_MAQUINA OR ('M' + RIGHT('000' + CAST(ofm.ID_MAQUINA AS VARCHAR(10)), 3)) = mf.ID_MAQUINA)
                            LEFT JOIN USUARIOS u2 ON o.ID_USUARIO = u2.ID_USUARIO
                            LEFT JOIN TURNOS tuo ON u2.ID_TURNO = tuo.ID_TURNO ORDER BY o.ID_ORDEN DESC
